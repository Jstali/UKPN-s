# ═══════════════════════════════════════════════════════════
# UKPN Audit App — Environment Configuration Template
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to version control!
# ═══════════════════════════════════════════════════════════

# ─── Proxy Server ──────────────────────────────────────────
# URL the React app uses to reach the proxy server.
# On Azure Virtual Desktop: change to the actual server hostname/IP if needed.
REACT_APP_API_URL=http://localhost:4000
PROXY_PORT=4000

# ─── Azure API Host (server-side only) ────────────────────
# The Azure Function App base URL. Only server.js reads this.
API_HOST=https://your-azure-function-app.azurewebsites.net

# ─── Azure Function API Codes (server-side only) ──────────
# These are read ONLY by server.js — they are never bundled into the browser.
# To update on Azure Virtual Desktop: edit this .env file and restart the proxy server.

DTC_API_CODE=your_dtc_api_code_here
SAP_API_CODE=your_sap_api_code_here
SUBSCRIPTION_CODE=your_subscription_api_code_here
FLOWS_API_CODE=your_flows_api_code_here
SOURCE_APP_API_CODE=your_source_app_api_code_here
DEST_APP_API_CODE=your_dest_app_api_code_here
APP_STATUS_API_CODE=your_app_status_api_code_here
DROPDOWN_VALUES_API_CODE=your_dropdown_values_api_code_here
FILE_STATUS_SUMMARY_CODE=your_file_status_summary_code_here
AUDIT_EMAIL_EXPORT_CODE=your_audit_email_export_code_here

# Optional: separate codes for file download/preview
# Falls back to DTC_API_CODE if left blank.
# DTC_DOWNLOAD_API_CODE=
# DTC_PREVIEW_API_CODE=

# ─── User Credentials (server-side only) ──────────────────
# Validated server-side on login — never sent to the browser.
# Format: JSON array of { username, password, role }
# Available roles: Business | Monitoring Team | Core Support | Admin | Testing Team
# To add/remove users on Azure Virtual Desktop: edit this file and restart the proxy server.
USERS=[{"username":"your_username","password":"your_strong_password","role":"Admin"}]

# ─── Redis Configuration ───────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── SMB/Database Credentials (server-side only) ──────────
# SMB_PASSWORD=your_smb_password
# DB_PASSWORD=your_database_password
