# ═══════════════════════════════════════════════════════════
# UKPN Audit App - Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in the actual values
# NEVER commit .env to version control!
# ═══════════════════════════════════════════════════════════

# ─── Application Settings ─────────────────────────────────
# API Host URL (Azure Function App)
REACT_APP_API_HOST=https://your-azure-function-app-host.azurewebsites.net

# Use API backend (true/false) - set to false for local development
REACT_APP_USE_API=false

# Local API base URL (for proxy server)
REACT_APP_API_URL=http://localhost:4000

# Proxy server port
PROXY_PORT=4000

# ─── Azure Function API Codes ─────────────────────────────
# DTC Audit API
REACT_APP_DTC_API_CODE=your_dtc_audit_api_code_here

# Non-DTC (SAP) Audit API
REACT_APP_SAP_API_CODE=your_sap_audit_api_code_here

# Subscription API
REACT_APP_SUBSCRIPTION_CODE=your_subscription_api_code_here

# Flows API
REACT_APP_FLOWS_API_CODE=your_flows_api_code_here

# Source Applications API
REACT_APP_SOURCE_APP_API_CODE=your_source_app_api_code_here

# Destination Applications API
REACT_APP_DEST_APP_API_CODE=your_dest_app_api_code_here

# Download/Preview API (optional - uses DTC_API_CODE if not set)
# REACT_APP_DTC_DOWNLOAD_API_CODE=your_download_api_code
# REACT_APP_DTC_PREVIEW_API_CODE=your_preview_api_code

# ─── Application Status API ───────────────────────────────
REACT_APP_APP_STATUS_API_CODE=your_app_status_api_code_here

# Dropdown Values API (From Role, From MPID, To Role, To MPID)
REACT_APP_DROPDOWN_VALUES_API_CODE=your_dropdown_values_api_code_here

# ─── Redis Configuration ──────────────────────────────────
# Redis connection URL for server-side caching
REDIS_URL=redis://localhost:6379

# ─── User Credentials (JSON format) ───────────────────────
# Format: [{"username":"user1","password":"pass123","role":"Role Name"}]
# IMPORTANT: Change these passwords in production!
REACT_APP_USERS=[{"username":"business","password":"business123","role":"Business"},{"username":"monitoring","password":"monitoring123","role":"Monitoring Team"},{"username":"support","password":"support123","role":"Core Support"},{"username":"admin","password":"admin123","role":"Admin"},{"username":"testuser","password":"testuser","role":"Testing Team"}]

# ─── SMB/Database Credentials (for server.js if needed) ───
# SMB_PASSWORD=your_smb_password
# DB_PASSWORD=your_database_password
