{
  "auth": {
    "identityProviders": {
      "azureActiveDirectory": {
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/887a239c-e092-45fe-92c8-d902c3681567/v2.0",
          "clientIdSettingName": "AAD_CLIENT_ID",
          "clientSecretSettingName": "AAD_CLIENT_SECRET"
        }
      }
    }
  },
  "routes": [
    { "route": "/login",       "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/.auth/*",     "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/static/*",    "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/manifest.json","allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/favicon.ico", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/*.svg",       "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/*.png",       "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/*.avif",      "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/*",           "allowedRoles": ["authenticated"] }
  ],
  "responseOverrides": {
    "401": { "redirect": "/login", "statusCode": 302 }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/.auth/*", "/static/*"]
  }
}
